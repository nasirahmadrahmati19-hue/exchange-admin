import withPWAInit from "@ducanh2912/next-pwa";

const withPWA = withPWAInit({
  dest: "public",
  disable: process.env.NODE_ENV === "development",
  fallbacks: {
    document: "/offline.html", // صفحه جایگزین در صورت آفلاین بودن
  },
  runtimeCaching: [
    {
      // فقط فایل‌های استاتیک Next.js (صفحات از پیش ساخته شده)
      urlPattern: /^https:\/\/[^/]+\/_next\/static\/.*/i,
      handler: "CacheFirst",
      options: {
        cacheName: "next-static",
        expiration: {
          maxEntries: 64,
          maxAgeSeconds: 24 * 60 * 60, // 24 ساعت
        },
      },
    },
    {
      // فایل‌های استاتیک (تصاویر، فونت‌ها، CSS)
      urlPattern: /\.(?:png|jpg|jpeg|svg|gif|webp|ico|woff|woff2|ttf|eot|css)$/i,
      handler: "CacheFirst",
      options: {
        cacheName: "static-assets",
        expiration: {
          maxEntries: 64,
          maxAgeSeconds: 24 * 60 * 60,
        },
      },
    },
    {
      // صفحات برنامه (navigation) - با اولویت شبکه و fallback به کش
      urlPattern: ({ request, url }) => {
        return (
          request.mode === "navigate" &&
          !url.pathname.startsWith("/api/") &&
          !url.pathname.includes("firebase")
        );
      },
      handler: "NetworkFirst",
      options: {
        cacheName: "pages",
        networkTimeoutSeconds: 5,
        expiration: {
          maxEntries: 32,
          maxAgeSeconds: 24 * 60 * 60,
        },
      },
    },
  ],
});

const nextConfig = {
  reactStrictMode: true,
};

export default withPWA(nextConfig);
