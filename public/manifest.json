import withPWAInit from "@ducanh2912/next-pwa";

const withPWA = withPWAInit({
  dest: "public",
  disable: process.env.NODE_ENV === "development",
  fallbacks: {
    document: "/offline.html", // اگر صفحه‌ای کش نشده بود، این فایل زیبا نمایش داده می‌شود
  },
  runtimeCaching: [
    {
      // ۱. کش کردن فایل‌های استاتیک Next.js (JS, CSS)
      urlPattern: /^https:\/\/[^/]+\/_next\/static\/.*/i,
      handler: "CacheFirst",
      options: {
        cacheName: "next-static",
        expiration: { maxEntries: 64, maxAgeSeconds: 24 * 60 * 60 },
      },
    },
    {
      // ۲. کش کردن فایل‌های public (شامل manifest.json و آیکون‌ها) -> رفع خطای Syntax
      urlPattern: /^https:\/\/[^/]+\/(manifest\.json|icon-.*\.png|.*\.(?:png|jpg|jpeg|svg|webp|ico|woff|woff2|ttf|css))$/i,
      handler: "CacheFirst",
      options: {
        cacheName: "public-assets",
        expiration: { maxEntries: 64, maxAgeSeconds: 24 * 60 * 60 },
      },
    },
    {
      // ۳. کش کردن صفحات (Navigation). اول شبکه، اگر نشد کش، اگر نشد offline.html
      urlPattern: ({ request }) => request.mode === "navigate",
      handler: "NetworkFirst",
      options: {
        cacheName: "pages-cache",
        networkTimeoutSeconds: 3, // فقط ۳ ثانیه صبر کن، اگر نشد سریع برو سراغ کش یا fallback
        expiration: { maxEntries: 32, maxAgeSeconds: 24 * 60 * 60 },
      },
    },
  ],
});

const nextConfig = {
  reactStrictMode: true,
};

export default withPWA(nextConfig);
