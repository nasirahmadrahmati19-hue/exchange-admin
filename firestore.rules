// =====================================================
// 🔐 Firestore Security Rules — صرافی برادران نورزاد
// ----------------------------------------------------
// اصل: هر کاربر فقط به داده‌های خودش دسترسی دارد.
// مدیر اصلی از طریق ایمیل و لیست allowList شناسایی می‌شود.
// =====================================================
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // توابع کمکی
    // =========================

    // آیا کاربر وارد حساب شده است؟
    function isSignedIn() {
      return request.auth != null;
    }

    // آیا کاربر مدیر اصلی است؟ (ایمیل + لیست allowList در /meta/admin)
    // نکته: اگر سند meta/admin وجود نداشت، خطا نده — فقط ایمیل چک شود.
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "nasirahmadrahmati19@gmail.com" ||
        (exists(/databases/$(database)/documents/meta/admin) &&
         request.auth.uid in get(/databases/$(database)/documents/meta/admin).data.allowList)
      );
    }

    // آیا کاربر می‌تواند سند پروفایل اولیه خود را بسازد؟
    // هر کاربر لاگین‌شده هنگام ثبت‌نام باید بتواند users/{uid} خودش را create کند.
    function isNewSelfProfile(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && !exists(/databases/$(database)/documents/users/$(userId));
    }

    // آیا کاربر صاحب این UID است؟
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // =========================
    // ⭐ ساختار جدید: داده‌های ایزوله شده هر کاربر ⭐
    // =========================
    // این خط تمام زیرمجموعه‌های کاربر (customers, transactions, hawalas, cash_entries, ...) را پوشش می‌دهد.
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // =========================
    // اطلاعات پروفایل کاربر (سند اصلی user)
    // =========================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // 🔓 ثبت‌نام عادی: هر کاربر لاگین‌شده می‌تواند پروفایل اولیه خودش را بسازد
      // (بدون نیاز به تأیید مدیر — حتی اگر سند meta/admin وجود نداشته باشد)
      allow create: if isOwner(userId) || isNewSelfProfile(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================
    // تنظیمات عمومی (نرخ ارز و...)
    // =========================
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // =========================
    // داده‌های عمومی یا تنظیمات برنامه (مسیر قدیمی appData)
    // =========================
    match /appData/{documentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // =========================
    // سند متادیتا (لیست مدیران) — فقط ادمین
    // =========================
    match /meta/{docId} {
      allow read, write: if isAdmin();
    }

    // =========================
    // کالکشن‌های قدیمی در ریشه (فقط ادمین)
    // =========================
    match /customers/{documentId}   { allow read, write: if isAdmin(); }
    match /transactions/{documentId} { allow read, write: if isAdmin(); }
    match /cash_entries/{documentId} { allow read, write: if isAdmin(); }
    match /hawalas/{documentId}      { allow read, write: if isAdmin(); }

    // =========================
    // هر مسیر دیگری (پیش‌فرض امن)
    // =========================
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
